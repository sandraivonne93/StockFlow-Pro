# ───────────────────────────────────────────────────────────
# StockFlow Pro - Variables de entorno (copia este archivo a .env)
# ───────────────────────────────────────────────────────────
# Estas claves son PÚBLICAS (anon key). Nunca pongas aquí la service_role key.

# URL de tu proyecto Supabase (Settings > API > Project URL)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave anónima pública (Settings > API > Project API keys > anon public)
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica

# Nombre de la app (opcional)
VITE_APP_NAME=StockFlow Pro
